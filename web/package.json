{
  "name": "stockdb",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-data-grid": "^9.13.0",
    "@mui/x-date-pickers": "^9.13.0",
    "classnames": "^2.5.1",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-number-format": "^5.4.5",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^3.1.0",
    "source-map-explorer": "^2.5.3",
    "typeface-open-sans": "^1.1.13",
    "typeface-oxygen": "^1.1.13",
    "typeface-roboto": "^1.1.13"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/redux-logger": "^3.0.13",
    "@vitejs/plugin-react": "^6.1.1",
    "enzyme": "^3.11.0",
    "eslint": "^10.10.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "start": "pnpm run git && vite --host 0.0.0.0",
    "build": "pnpm run git && vite build && node -e \"require('node:fs').copyFileSync('src/serviceWorkerCustomizations.js', 'build/service-worker.js');\"",
    "test": "vitest run",
    "test:lint:js": "eslint \"src/**/*.{js,ts,tsx}\"",
    "test:types": "tsc --noEmit",
    "analyze": "source-map-explorer 'build/assets/*.js' --html > build/bundle-analysis.html",
    "git": "node -e \"const { execFileSync } = require('node:child_process'); const commit = execFileSync('git', ['log', '--pretty=format:%h', '-n', '1'], { encoding: 'utf8' }).trim(); console.log(\\\"export const buildCommit = '\\\" + commit + \\\"';\\\\nexport const buildDate = '\\\" + new Date().toISOString() + \\\"';\\\");\" > src/git.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
