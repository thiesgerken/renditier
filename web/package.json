{
  "name": "stockdb",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@reduxjs/toolkit": "^2.14.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "^26.7.2",
    "lodash": "^4.18.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.1.13",
    "react-number-format": "^5.4.5",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "simple-icons": "^16.36.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "shadcn": "^4.23.0",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "eslint": "$eslint"
  },
  "scripts": {
    "start": "npm run git && vite --host 0.0.0.0",
    "build": "npm run git && vite build && node -e \"require('node:fs').copyFileSync('src/serviceWorkerCustomizations.js', 'build/service-worker.js');\"",
    "test": "vitest run",
    "test:lint:js": "eslint \"src/**/*.{js,ts,tsx}\"",
    "test:types": "tsc --noEmit",
    "analyze": "source-map-explorer 'build/assets/*.js' --html > build/bundle-analysis.html",
    "git": "node -e \"const { execFileSync } = require('node:child_process'); const commit = process.env.BUILD_COMMIT ?? execFileSync('git', ['log', '--pretty=format:%h', '-n', '1'], { encoding: 'utf8' }).trim(); console.log(\\\"export const buildCommit = '\\\" + commit + \\\"';\\\\nexport const buildDate = '\\\" + new Date().toISOString() + \\\"';\\\");\" > src/git.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
