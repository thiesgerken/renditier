{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":preserveSemverRanges",
    "group:allNonMajor",
    "local>renovate/renovate-config"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "groupName": "npm patch dependencies",
      "automerge": true
    },
    {
      "description": "stockdb:main is a moving tag that CI rewrites on every merge, so a digest pin in docker-compose.yaml would go stale with the next merge and run an old build",
      "matchPackageNames": ["gitea.gerken.haus/thies/stockdb"],
      "enabled": false
    }
  ]
}
