{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":preserveSemverRanges",
    "group:allNonMajor",
    "local>renovate/renovate-config"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/^\\.gitea/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "npm (?:i|install) -g pnpm@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "groupName": "npm patch dependencies",
      "automerge": true
    },
    {
      "description": "pnpm releases often and its minor/patch bumps are routine; the groupName splits them out of the grouped update PR so they can merge on green by themselves",
      "matchDepNames": ["pnpm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "pnpm",
      "automerge": true
    }
  ]
}
